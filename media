import React, { useState } from 'react';
import { View, Text, TextInput, TouchableOpacity, StyleSheet, Alert } from 'react-native';

export default function App() {
  const [nome, setNome] = useState('');
  const [nota1, setNota1] = useState('');
  const [nota2, setNota2] = useState('');
  const [nota3, setNota3] = useState('');
  const [dadosResultado, setDadosResultado] = useState(null);

  const calcularMedia = () => {
    if (!nome.trim()) {
      Alert.alert('Erro', 'Informe o nome do estudante.');
      return;
    }

    const n1 = parseFloat(nota1.replace(',', '.'));
    const n2 = parseFloat(nota2.replace(',', '.'));
    const n3 = parseFloat(nota3.replace(',', '.'));

    const notasValidas = [n1, n2, n3].every((n) => !isNaN(n) && n >= 0 && n <= 10);

    if (!notasValidas) {
      Alert.alert('Erro', 'Todas as notas devem ser números entre 0 e 10.');
      setDadosResultado(null);
      return;
    }

    const media = (n1 + n2 + n3) / 3;
    const situacao = media >= 7.0 ? 'Aprovado' : 'Reprovado';

    setDadosResultado({
      nome: nome.trim(),
      media: media.toFixed(1).replace('.', ','),
      situacao,
    });
  };

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Boletim Acadêmico</Text>

      <TextInput
        style={styles.input}
        placeholder="Nome do estudante"
        value={nome}
        onChangeText={setNome}
      />
      <TextInput
        style={styles.input}
        placeholder="Nota 1 (0 a 10)"
        keyboardType="numeric"
        value={nota1}
        onChangeText={setNota1}
      />
      <TextInput
        style={styles.input}
        placeholder="Nota 2 (0 a 10)"
        keyboardType="numeric"
        value={nota2}
        onChangeText={setNota2}
      />
      <TextInput
        style={styles.input}
        placeholder="Nota 3 (0 a 10)"
        keyboardType="numeric"
        value={nota3}
        onChangeText={setNota3}
      />

      <TouchableOpacity style={styles.botao} onPress={calcularMedia}>
        <Text style={styles.textoBotao}>Calcular média</Text>
      </TouchableOpacity>

      {dadosResultado && (
        <View style={styles.card}>
          <Text style={styles.textoResultado}>Estudante: {dadosResultado.nome}</Text>
          <Text style={styles.textoResultado}>Média: {dadosResultado.media}</Text>
          <Text
            style={[
              styles.situacao,
              { color: dadosResultado.situacao === 'Aprovado' ? '#2b9348' : '#d00000' },
            ]}
          >
            Situação: {dadosResultado.situacao}
          </Text>
        </View>
      )}
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, justifyContent: 'center', padding: 24, backgroundColor: '#f8f9fa' },
  titulo: { fontSize: 22, fontWeight: 'bold', marginBottom: 20, textAlign: 'center' },
  input: { backgroundColor: '#fff', borderWidth: 1, borderColor: '#ced4da', borderRadius: 8, padding: 12, marginBottom: 12, fontSize: 16 },
  botao: { backgroundColor: '#3a86ff', padding: 14, borderRadius: 8, alignItems: 'center', marginTop: 4 },
  textoBotao: { color: '#fff', fontSize: 16, fontWeight: 'bold' },
  card: { marginTop: 20, padding: 16, backgroundColor: '#fff', borderRadius: 8, borderWidth: 1, borderColor: '#dee2e6' },
  textoResultado: { fontSize: 16, marginBottom: 4 },
  situacao: { fontSize: 18, fontWeight: 'bold', marginTop: 6 },
});
